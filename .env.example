# Provider keys — env vars win; keys saved via the dashboard fill the gaps.
# Never commit real values.
GROQ_API_KEY=
GEMINI_API_KEY=
GONKA_API_KEY=

# --- agent0 ---
AGENT0_DATABASE_URL=postgresql://agent0:agent0@127.0.0.1:5434/agent0
# Bearer token for the API and the dashboard proxy. Change it.
AGENT0_API_KEY=change-me
# Fernet key for encrypting dashboard-stored provider keys: `uv run agent0 secrets-keygen`
AGENT0_SECRET_KEY=

# local (in-process, dev) or temporal (durable runs)
AGENT0_ORCHESTRATOR=local
AGENT0_TEMPORAL_ADDRESS=localhost:7233

# docker (default, isolated) or local (dev only — commands run on your machine)
AGENT0_SANDBOX=docker
# AGENT0_SANDBOX_IMAGE=agent0-sandbox:latest
# AGENT0_WORKSPACE_ROOT=.agent0/workspaces

# Optional daily spend cap across all runs (USD)
# AGENT0_DAILY_BUDGET_USD=5.0

# Telegram bot — from @BotFather; allowed users are Telegram ids or @usernames
AGENT0_TELEGRAM_BOT_TOKEN=
AGENT0_TELEGRAM_ALLOWED_USERS=[]

# Optional demo dataset for examples/analytics (seed: examples/analytics/seed.sql).
# When unset, the 'sales' knowledge source is skipped.
# AGENT0_SALES_DSN=postgresql://agent0:agent0@127.0.0.1:5434/agent0

# Comma-separated origins the API may serve (dashboard dev server)
# AGENT0_CORS_ORIGINS=http://localhost:3000
