# Copy to .env.cloud in the repo root (git-ignored) and fill in. Keep it chmod 600.
# Comments sit on their own lines on purpose.

# --- Compose ---
API_DOMAIN=api.example.com
# openssl rand -hex 24 (hex only, because it is embedded in a URL)
POSTGRES_PASSWORD=
# Pin a version once it works, e.g. temporalio/temporal:<tag>
# TEMPORAL_IMAGE=temporalio/temporal:latest

# --- agent0 ---
# openssl rand -hex 32. The API refuses to start with env=cloud and the default key.
AGENT0_API_KEY=
# Fernet key from: docker compose --env-file .env.cloud -f infra/docker-compose.cloud.yml run --rm --no-deps api secrets-keygen
# Losing it makes keys stored from the dashboard unreadable.
AGENT0_SECRET_KEY=
AGENT0_CORS_ORIGINS=["https://your-dashboard.vercel.app"]
AGENT0_TELEGRAM_BOT_TOKEN=
AGENT0_TELEGRAM_ALLOWED_USERS=["123456789"]

# --- Model providers (or add them later from the dashboard) ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- E2B sandbox ---
E2B_API_KEY=
# Optional custom template id; the default is E2B's base template.
# E2B_TEMPLATE=
# Seconds a sandbox may live.
# E2B_SANDBOX_TIMEOUT=1800

# --- Optional overrides (defaults shown) ---
# AGENT0_TASK_QUEUE=agent0
# AGENT0_TEMPORAL_NAMESPACE=default
