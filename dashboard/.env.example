# Server-only configuration. None of these are exposed to the browser (no NEXT_PUBLIC_ vars are used).

# Base URL of the agent0 backend (the proxy appends /api/v1/...).
AGENT0_API_URL=http://127.0.0.1:8000
# Bearer token the proxy sends to the backend. Must match the backend's AGENT0_API_KEY.
AGENT0_API_KEY=change-me
# Set to 1 to serve fixtures from src/mocks (no backend needed), including a fake SSE stream.
AGENT0_MOCK=0
# Password for the dashboard login page. Required: without it nobody can sign in.
DASHBOARD_PASSWORD=change-me
# Optional: separate secret for signing session cookies (defaults to a key derived from DASHBOARD_PASSWORD).
# DASHBOARD_SESSION_SECRET=
